# JMFTS Configuration
# Copy to .env and fill in values. Every setting below is a real field on
# `Settings` in jmfts_core/config.py; the value shown is the built-in default.
# Commented lines are optional — uncomment only to change the default.

# ---------------------------------------------------------------- Database
JMFTS_DB_HOST=localhost
JMFTS_DB_PORT=5432
JMFTS_DB_NAME=jmfts
JMFTS_DB_USER=jmfts
JMFTS_DB_PASSWORD=your_password_here

# --------------------------------------------------------------------- API
JMFTS_API_HOST=0.0.0.0
JMFTS_API_PORT=8100
JMFTS_DEBUG=true

# Shared bearer token. Every request must send `Authorization: Bearer <token>`.
# Leave BLANK to have the server generate an ephemeral token at startup and print
# it to stdout (required on every request, like Jupyter) — a blank token never
# means "allow all". Set a value to pin a fixed token and silence the message.
JMFTS_API_TOKEN=

# JSON list of allowed browser origins. Empty (the default) = server-to-server
# only; no Origin is permitted. Never use "*" here (it is rejected alongside
# credentials). Example: JMFTS_CORS_ORIGINS=["https://app.example.com"]
JMFTS_CORS_ORIGINS=[]

# Clients (scripts/) read JMFTS_API_BASE_URL from the environment to decide which
# instance to talk to. It is a client-side variable, not a server setting.
# JMFTS_API_BASE_URL=http://localhost:8100

# ----------------------------------------------------------- Ingest worker
# The file pipeline is asynchronous: POST /ingest/file returns once the bytes are
# stored and `probe` is enqueued, and a worker thread inside this process drains
# the queue. On by default — an appliance that accepts uploads and never processes
# them is not a useful default.
# JMFTS_INGEST_WORKER_ENABLED=true
# JMFTS_INGEST_WORKER_POLL_SECONDS=1.0

# --------------------------------------------------------- Embedding model
JMFTS_EMBEDDING_MODEL=nomic-ai/modernbert-embed-base
JMFTS_EMBEDDING_DEVICE=cpu  # set to "cuda" for GPU-accelerated bulk ingestion
JMFTS_EMBEDDING_BATCH_SIZE=32
# JMFTS_TOKEN_BATCH_SIZE=32

# Model windows. Text over the window is REFUSED, not silently truncated.
# JMFTS_EMBEDDING_TOKEN_WINDOW=512
# JMFTS_EMBEDDING_DOC_WINDOW=8192

# ------------------------------------------------- Late interaction (MaxSim)
# Only 256 is active; the schema reserves 384/512 halfvec columns.
JMFTS_TOKEN_EMBED_DIMS=[256]
JMFTS_TOKEN_TOP_PERCENT=0.5

# ------------------------------------------------------------------ Chunking
# JMFTS_CHUNK_MAX_CHARS=1800

# ---------------------------------------------------------------- Retrieval
JMFTS_BM25_K1=1.2
JMFTS_BM25_B=0.75
# Usetypes held out of the BM25 index and of search results respectively.
# JMFTS_BM25_EXCLUDE_USETYPES=["entity","summary"]
# JMFTS_SEARCH_EXCLUDE_USETYPES=["entity","summary"]

# Cross-encoder reranker (second stage for ?rerank=true). Any Hub cross-encoder
# works; the default is ~22M params and downloads on first use. Leave DEVICE blank
# to follow JMFTS_EMBEDDING_DEVICE — a CPU-only box then stays CPU-only without
# setting this twice. NOTE: this default is chosen for size, not for measured
# retrieval quality. See README.
JMFTS_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
JMFTS_RERANKER_DEVICE=
JMFTS_RERANKER_MAX_LENGTH=512
JMFTS_RERANKER_BATCH_SIZE=32

# --------------------------------------------------------------------- LLM
# OpenAI-compatible endpoint used by synthesis, RAPTOR summarization and fact
# extraction. Works with llama-server, vLLM, Ollama, etc. Leave blank to fall
# back to the JMFTS_ENSONET_* values below.
JMFTS_LLM_BASE_URL=http://localhost:11434/v1
JMFTS_LLM_MODEL=qwen3-32b
JMFTS_LLM_TIMEOUT=120.0

# Fallback endpoint, used only when the JMFTS_LLM_* values above are unset.
# JMFTS_ENSONET_URL=http://localhost:8853
# JMFTS_ENSONET_MODEL=THUDM_GLM4_32b
# JMFTS_ENSONET_TIMEOUT=180.0

# ----------------------------------------------------------- Summarization
# Tunes the LLM request; there is no local inference process.
# JMFTS_SUMMARIZATION_CONTEXT=4096
# JMFTS_SUMMARIZATION_TEMPERATURE=0.3
# Reasoning models otherwise spend the token budget thinking and return empty
# content on small budgets.
# JMFTS_SUMMARIZATION_DISABLE_THINKING=true
# JMFTS_SYNTHESIS_MAX_TOKENS=65536

# -------------------------------------- RAPTOR hierarchical summarization
# JMFTS_RAPTOR_MAX_SUMMARY_TOKENS=7168
# JMFTS_RAPTOR_MAX_DEPTH=5
# JMFTS_RAPTOR_MIN_CLUSTER_SIZE=2
# JMFTS_RAPTOR_K_BASE=5            # k-NN neighbours at layer 0
# JMFTS_RAPTOR_K_STEP=3            # k increases by this per layer
# JMFTS_RAPTOR_GAMMA_BASE=1.0      # Leiden resolution at layer 0
# JMFTS_RAPTOR_GAMMA_DECAY=0.5     # gamma multiplied by this per layer
# JMFTS_RAPTOR_BRIDGE_THRESHOLD=0.7

# ------------------------------------------------------- Fact extraction
# JMFTS_EXTRACTION_MAX_FACTS=5
# JMFTS_EXTRACTION_CONFIDENCE_THRESHOLD=0.5
# JMFTS_EXTRACTION_ENTITY_SIMILARITY_THRESHOLD=0.8
# JMFTS_EXTRACTION_TEMPERATURE=0.1
# JMFTS_EXTRACTION_MAX_TOKENS=4096
