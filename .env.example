# JMFTS Configuration
# Copy to .env and fill in values.
#
# This file lists EVERY setting `jmfts_core.config.Settings` reads, with its real
# default. A setting you must choose is left uncommented; a tuning knob that has a
# working default is shown commented out, with that default as the value. Nothing is
# omitted — a config template that quietly lacks a setting teaches you the setting does
# not exist.
#
# Two names below are read from the environment directly by jmfts_core/worker.py rather
# than through Settings: JMFTS_WORKER_ID and JMFTS_WORKER_BADGE.

# Database
JMFTS_DB_HOST=localhost
JMFTS_DB_PORT=5432
JMFTS_DB_NAME=jmfts
JMFTS_DB_USER=jmfts
JMFTS_DB_PASSWORD=your_password_here

# API
JMFTS_API_HOST=0.0.0.0
JMFTS_API_PORT=8100
JMFTS_DEBUG=true

# Auth (CR-4): shared bearer token. Every request must send
# `Authorization: Bearer <token>`. Leave BLANK to have the server generate an
# ephemeral token at startup and print it to stdout (required on every request,
# like Jupyter) — a blank token never means "allow all". Set a value to pin a
# fixed token and silence the startup message.
JMFTS_API_TOKEN=

# Runner key: the credential for the /runner surface, which embeds text for a caller that
# stores the vectors in its own database. It is NOT an API token — it resolves to no
# principal and grants no access to any document — so it is a separate value on purpose.
#
# Blank (the default) turns the surface OFF: /runner answers 503. That differs from
# JMFTS_API_TOKEN, where blank means generate-and-print, because a fleet of replicas would
# each generate a different key. Set the same value here and on every worker that calls in;
# in Kubernetes both read it from one Secret.
JMFTS_RUNNER_KEY=

# The client half of the same pair: where THIS process sends text when it needs a vector.
# Set it and the ingest write path — the `embed` task, and the vector `summarize` writes —
# goes to another JMFTS's /runner surface, and this process never loads the embedding model
# for that work. Blank (the default) means embed locally, which is what one appliance does.
#
# Both sides read JMFTS_RUNNER_KEY above; a URL with no key is refused at startup rather
# than tried anonymously. The worker CLI's --runner-url sets this.
#
# SCOPE. This covers ingest. SEARCH still embeds its queries locally, because a query embed
# is one forward pass in the request path and routing it over HTTP would put a network hop
# inside every search — so a process that serves /search still needs the model. The process
# this empties out is a worker.
JMFTS_RUNNER_URL=
# A cold runner loads several GB before it can answer the first call, so this is sized for
# that rather than for the steady state.
# JMFTS_RUNNER_TIMEOUT=300.0

# CORS (CR-4): JSON list of allowed browser origins. Empty (the default) =
# server-to-server only; no Origin is permitted. Never use "*" here (it is
# rejected alongside credentials). Example: JMFTS_CORS_ORIGINS=["https://app.example.com"]
JMFTS_CORS_ORIGINS=[]

# ---------------------------------------------------------------------------
# Embedding model
# ---------------------------------------------------------------------------
JMFTS_EMBEDDING_MODEL=nomic-ai/modernbert-embed-base
JMFTS_EMBEDDING_DEVICE=cpu  # set to "cuda" for GPU-accelerated bulk ingestion
JMFTS_EMBEDDING_BATCH_SIZE=32
# Documents per batch on the token-level path, which is far heavier than the document one.
# JMFTS_TOKEN_BATCH_SIZE=32

# Embedding windows. The model handles 8192 tokens, and the document-vector path uses all
# of it. The token path is capped far lower because embed_with_tokens runs the transformer
# with output_attentions=True under eager attention, which materialises every layer's full
# attention matrix: layers * heads * seq^2 * 4 bytes. For ModernBERT-base that is ~277 MB
# at 512 and ~71 GB at 8192. So the token window is a MEMORY BUDGET, not a model limit —
# which is why text over it is refused rather than truncated to a prefix that looks whole.
# JMFTS_EMBEDDING_TOKEN_WINDOW=512
# JMFTS_EMBEDDING_DOC_WINDOW=8192

# ---------------------------------------------------------------------------
# Late interaction (MaxSim)
# ---------------------------------------------------------------------------
# Fraction of a document's tokens kept as token-level embeddings. 0.5 stores the top half,
# which is what the tiered benchmarking layout assumes.
JMFTS_TOKEN_TOP_PERCENT=0.5
# Matryoshka dimensions for token embeddings. The schema has columns for 384 and 512, but
# only 256 is active and validated; adding a dimension here writes rows nothing reads.
JMFTS_TOKEN_EMBED_DIMS=[256]

# ---------------------------------------------------------------------------
# Chunking
# ---------------------------------------------------------------------------
# A hard character cap applied after splitting, for every strategy. Sized to land inside
# JMFTS_EMBEDDING_TOKEN_WINDOW: English runs about 5 characters per subword token, so 1800
# characters is roughly 360 tokens, leaving headroom for the "search_document: " prefix and
# for text that tokenises less efficiently than prose.
# JMFTS_CHUNK_MAX_CHARS=1800

# ---------------------------------------------------------------------------
# BM25 and search
# ---------------------------------------------------------------------------
JMFTS_BM25_K1=1.2
JMFTS_BM25_B=0.75
# Usetypes held out of the BM25 index and out of search results. `summary` and `entity`
# nodes are derived from other documents, so counting them returns the same content twice;
# `entities` is the container that holds entity nodes and is never an answer either.
# JMFTS_BM25_EXCLUDE_USETYPES=["entity", "entities", "summary"]
# JMFTS_SEARCH_EXCLUDE_USETYPES=["entity", "entities", "summary"]

# Cross-encoder reranker (second stage for ?rerank=true&rerank_method=cross_encoder).
# Any Hub cross-encoder works; the default is ~22M params and downloads on first use.
# Leave DEVICE blank to follow JMFTS_EMBEDDING_DEVICE — a CPU-only box then stays
# CPU-only without setting this twice.
JMFTS_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
JMFTS_RERANKER_DEVICE=
JMFTS_RERANKER_MAX_LENGTH=512
JMFTS_RERANKER_BATCH_SIZE=32

# ---------------------------------------------------------------------------
# SHACL validation and rule derivation
# ---------------------------------------------------------------------------
# How many documents one `validate:shape` or `derive:rule` run may bind. `pyshacl` has no
# streaming mode, so a scope that does not fit in memory is a refusal rather than a slow
# success, and a killed run has no partial progress to resume from. 512 is deliberately far
# below anything measured — 138,000 documents peaked at a whole cpu worker's memory request —
# so a fresh install refuses long before it can be OOM-killed, and raising this is an
# operator saying they have measured their own ceiling. `ScopeTooLargeError` names this
# variable in its refusal, so the knob teaches itself.
#
# It must be an integer. The field is `int | None` and `None` means unbounded, but `None`
# is reachable only from Python — a blank, `null` or `None` here is a pydantic
# `int_parsing` error at startup, not "no bound".
# JMFTS_SHACL_MAX_SCOPE_DOCUMENTS=512

# ---------------------------------------------------------------------------
# LLM endpoint
# ---------------------------------------------------------------------------
# Any OpenAI-compatible server: llama-server, vLLM, Ollama, ensonet, or a metered web API.
#
# BLANK BY DEFAULT, and deliberately so. JMFTS does not ship an LLM, so there is no address
# it could name that would be right for a fresh install: a default pointing at some
# particular host answers nothing on anyone else's machine, and turns "you have not
# configured an LLM" into a connection error that reads like a bug in JMFTS.
#
# Leaving these unset is a supported configuration. Ingestion, embedding, chunking,
# indexing and all four search modes work without an LLM. What needs one is the
# summarize:llm task, RAPTOR, fact extraction and the synthesis endpoint; each of those
# raises a message naming these variables rather than failing as a connection error, and
# GET /health reports "not configured" rather than "unreachable".
#
# THE SERVER ROOT, WITH NO `/v1`. jmfts_core/llm_client.py appends it. Every
# OpenAI-compatible server advertises itself as `https://host/v1`, so the address you were
# given is almost certainly one segment too long — paste `http://gpu-box:8080`, not
# `http://gpu-box:8080/v1`, or every call 404s at `/v1/v1`.
#
# `GET /health/llm` is the check, and read its BODY rather than its status: a misconfigured
# endpoint answers HTTP 200 with `"openai_compatible": false` and a detail naming the 404.
# Measured (docs/STRESS_CORPUS.md 1.4): 35 summarize:llm tasks failed this way.
JMFTS_LLM_BASE_URL=
JMFTS_LLM_MODEL=
# 0 means "use JMFTS_ENSONET_TIMEOUT", which is 180.0.
# JMFTS_LLM_TIMEOUT=0

# Bearer token for the LLM endpoint, sent as `Authorization: Bearer ...` and ONLY when
# non-empty. Blank for a llama-server on the LAN that wants no auth; set from a Secret for
# a worker pool that forwards to a metered API. One image serves both.
# JMFTS_LLM_API_KEY=

# A named second source for the same three values, lower precedence than JMFTS_LLM_* above.
# ensonet is a GPU-aware model orchestrator; there are no ensonet-specific code paths, it
# is one possible OpenAI-compatible backend. The timeout keeps a real default because it
# says how long to wait rather than where to connect, and a cold model load is slow.
# JMFTS_ENSONET_URL=
# JMFTS_ENSONET_MODEL=
# JMFTS_ENSONET_TIMEOUT=180.0

# Summarization request shape — how to call the endpoint above, not which one.
# JMFTS_SUMMARIZATION_CONTEXT=4096
# JMFTS_SUMMARIZATION_TEMPERATURE=0.3
# Suppress reasoning via chat_template_kwargs (llama.cpp, vLLM). A reasoning model
# otherwise spends the token budget thinking, and with a small budget the content comes
# back empty and the reasoning trace gets used as the summary.
# JMFTS_SUMMARIZATION_DISABLE_THINKING=true

# Token budgets for the two LLM-backed endpoints.
# JMFTS_SYNTHESIS_MAX_TOKENS=65536
# JMFTS_RAPTOR_MAX_SUMMARY_TOKENS=7168

# ---------------------------------------------------------------------------
# RAPTOR hierarchical summarization
# ---------------------------------------------------------------------------
# JMFTS_RAPTOR_MAX_DEPTH=5
# JMFTS_RAPTOR_MIN_CLUSTER_SIZE=2
# JMFTS_RAPTOR_K_BASE=5           # k-NN neighbours at layer 0
# JMFTS_RAPTOR_K_STEP=3           # k grows by this much per layer
# JMFTS_RAPTOR_GAMMA_BASE=1.0     # Leiden resolution at layer 0
# JMFTS_RAPTOR_GAMMA_DECAY=0.5    # gamma multiplied by this per layer
# JMFTS_RAPTOR_BRIDGE_THRESHOLD=0.7   # cosine similarity that makes a bridge link

# ---------------------------------------------------------------------------
# Fact extraction
# ---------------------------------------------------------------------------
# JMFTS_EXTRACTION_MAX_FACTS=5                      # triples kept per segment
# JMFTS_EXTRACTION_CONFIDENCE_THRESHOLD=0.5
# JMFTS_EXTRACTION_ENTITY_SIMILARITY_THRESHOLD=0.8  # string similarity for entity resolution
# JMFTS_EXTRACTION_TEMPERATURE=0.1
# JMFTS_EXTRACTION_MAX_TOKENS=4096

# ---------------------------------------------------------------------------
# Ingest
# ---------------------------------------------------------------------------
# How long `POST /ingest` waits for the document's tasks to drain before giving up. That
# endpoint is synchronous by design — it returns a finished tree — so this bounds the
# CALLER's patience, not the work: the tasks stay queued and the background worker
# finishes them either way. It is a request timeout, sized against what sits behind a
# proxy. Anything slower belongs on `POST /ingest/file`, which returns as soon as `probe`
# is enqueued and lets the client poll the frontier.
# JMFTS_INGEST_SYNC_TIMEOUT_SECONDS=300.0

# ---------------------------------------------------------------------------
# Ingest worker fleet
# ---------------------------------------------------------------------------
# The worker runs two ways: as a thread inside the API process (the appliance default,
# below) and as its own process via `jmfts-worker` / `python -m jmfts_core.worker`. Set
# JMFTS_INGEST_WORKER_ENABLED=false on the API when a separate fleet is doing the work,
# so the fleet's capacity does not depend on how many API replicas happen to be running.
# JMFTS_INGEST_WORKER_ENABLED=true
# JMFTS_INGEST_WORKER_POLL_SECONDS=1.0

# Fleet liveness (migration 011). A worker touches task_queue.heartbeat_at while it holds
# a task; any worker requeues a task whose last beat is older than the lease. The lease
# bounds how long a LIVE worker may go without reporting in — NOT how long a task may run,
# which is unbounded by design. Startup refuses a lease under 3x the beat: below that,
# ordinary scheduling delay costs a worker a task it is still running, and the task then
# runs twice, concurrently, against the same tree region.
# JMFTS_WORKER_HEARTBEAT_SECONDS=10.0
# JMFTS_WORKER_LEASE_SECONDS=90.0
# JMFTS_WORKER_REAP_SECONDS=30.0

# Identity written to task_queue.claimed_by. Must be unique across the fleet, and is worth
# making stable across a restart: a worker that comes back under the same id reclaims its
# own in-flight rows immediately instead of waiting out the lease. Defaults to
# {hostname}-{pid}, which is unique but not stable. Under Kubernetes, set it from the pod
# name via the downward API.
# JMFTS_WORKER_ID=

# Which badges this worker claims, comma-separated (the CLI form is a repeated --badge).
# It also claims un-badged work. An UN-BADGED worker claims EVERYTHING — right for a single
# appliance, and in a fleet it is how embedding ends up on a CPU host while the GPU idles,
# and how a metered API gets paid for work a local model would have done free.
#
# A list because capability and routing are different things: a host running an LLM on a
# GPU serves both pools, while a runner that forwards to a web API serves only the LLM one.
# Badges are a FILTER, not a preference order — claim_next still orders by priority then
# age across every badge a worker answers.
# JMFTS_WORKER_BADGE=embed,llm

# Task-type -> badge routing, applied at enqueue. EMPTY BY DEFAULT and that matters: a
# cpu-badged worker does not claim gpu-badged work, so a deployment that sets this without
# running a worker for every badge it names does not run slowly, it STALLS — the tasks sit
# pending forever and their nodes never leave in_flight. Turn it on where the worker pools
# are defined. The value below is the measured policy (jmfts_core/task_routing.py): these
# task types are measured, not guessed, and they were 99.9% of ingest wall clock end to end.
#
# TWO RESOURCES, separately priced. `embed` is the embedding model; `llm` is a completion,
# and it names the RESOURCE rather than the hardware — a local model on a GPU and a light
# forwarder to a metered web API both answer it. `summarize` is on `embed` because it always
# embeds and only DECIDES whether a completion is needed; when one is, it enqueues
# `summarize:llm`, which carries the `llm` badge.
# JMFTS_TASK_BADGES={"structure:declared":"embed","structure:inferred":"embed","summarize":"embed","summarize:llm":"llm"}
