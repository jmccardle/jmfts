# Virtual environment
venv/
.venv/

# Environment files with secrets
.env
.env.beir

# Local Compose overrides. docker-compose.override.yml is picked up automatically and
# holds one machine's addresses and model paths; it says "not for commit" in its own
# header, and this is what makes that hold.
docker-compose.override.yml

# Held-back working notes. Nothing shipped cites them; a doc moves to docs/ when it has had
# a review pass and something shipped cites it.
.archive/

# Benchmark data (symlinks / large corpora live under /storage)
datasets/
test_docs/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
eggs/
*.egg

# IDE
.idea/
.vscode/
*.swp
*.swo

# Testing
.pytest_cache/
.coverage
htmlcov/

# Misc
.DS_Store
*.log
jmfts-needle/heads/*.pt
jmfts-needle/experiments/e6_index.npz

# Lock files. There is no uv.lock on purpose: every installer this project runs is pip, and
# torch comes from an index chosen at install time. See the comment above `dependencies`
# in pyproject.toml. A lock that nothing installs from or checks only rots (#31).
uv.lock

# jmfts-eval result files (jmfts_core/eval/cli.py); results live beside the run, not in the tree
eval-results/
